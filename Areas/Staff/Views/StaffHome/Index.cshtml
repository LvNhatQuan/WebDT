@{
    Layout = "~/Areas/Staff/Views/Shared/_StaffLayout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<h3 class="fw-bold mb-4">👨‍💼 Trang làm việc nhân viên</h3>

<div class="row g-4">

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="fw-bold text-primary">
                    <i class="bi bi-truck"></i> Đơn hàng chờ xử lý
                </h5>
                <p class="display-6 fw-bold">--</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="fw-bold text-success">
                    <i class="bi bi-box-seam"></i> Đang giao
                </h5>
                <p class="display-6 fw-bold">--</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="fw-bold text-warning">
                    <i class="bi bi-star"></i> Review mới
                </h5>
                <p class="display-6 fw-bold">--</p>
            </div>
        </div>
    </div>

</div>
