@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Trang Nhân Viên D&T</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebDT.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <link rel="icon" type="image/png" href="~/Images/Logo_Bg/logo trang.png" />

    <style>
        body {
            background-color: #f4f5f7;
        }

        .staff-layout {
            min-height: 100vh;
        }

        /* ===== SIDEBAR ===== */
        .staff-sidebar {
            width: 260px;
            background: #004225; /* giống admin */
            color: #e5e7eb;
            padding: 20px 0;
        }

            .staff-sidebar .brand {
                font-size: 1.05rem;
                font-weight: 600;
                padding: 0 24px 16px 24px;
                color: #f9fafb;
            }

            .staff-sidebar .menu-title {
                font-size: 0.75rem;
                letter-spacing: .08em;
                text-transform: uppercase;
                padding: 0 24px;
                margin-top: 12px;
                margin-bottom: 6px;
                color: #9ca3af;
            }

            .staff-sidebar .nav-link {
                color: #e5e7eb;
                padding: 8px 24px;
                font-size: 0.9rem;
                border-radius: 999px;
                margin: 2px 10px;
            }

                .staff-sidebar .nav-link:hover,
                .staff-sidebar .nav-link.active {
                    background: #374151;
                    color: #ffffff;
                }

                .staff-sidebar .nav-link i {
                    margin-right: 8px;
                }

        /* ===== MAIN ===== */
        .staff-main {
            flex: 1;
            background: #f4f5f7;
        }

        .staff-topbar {
            height: 60px;
            background: #ffffff;
            border-bottom: 1px solid #e5e7eb;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
        }

        .staff-content {
            padding: 24px;
        }

        .staff-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
            padding: 20px 24px;
        }

        .staff-card-title {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 16px;
        }
    </style>
</head>
<body>
    <div class="d-flex staff-layout">

        <!-- ===== SIDEBAR ===== -->
        <aside class="staff-sidebar d-flex flex-column">
            <div class="brand mb-3">
                <div class="d-flex align-items-center">
                    <img src="~/Images/Logo_Bg/logo trang.png" style="height:40px;margin-right:8px;" />
                    <span style="font-weight:bold;font-size:18px;">
                        Trang Nhân Viên D&T
                    </span>
                </div>
            </div>

            <div class="menu-title">Chức năng</div>
            <nav class="nav flex-column mb-2">

                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "StaffHome" ? "active" : "")"
                   href="/Staff/StaffHome/Index">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>

                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "StaffOrder" ? "active" : "")"
                   href="/Staff/StaffOrder/Index">
                    <i class="bi bi-bag-check"></i> Đơn hàng
                </a>

                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "StaffShipping" ? "active" : "")"
                   href="/Staff/StaffShipping/Index">
                    <i class="bi bi-truck"></i> Giao hàng
                </a>

                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "StaffReview" ? "active" : "")"
                   href="/Staff/StaffReview/Index">
                    <i class="bi bi-chat-left-text"></i> Đánh giá
                </a>

            </nav>


            <div class="mt-auto">
                <div class="menu-title">Tài khoản</div>
                <nav class="nav flex-column">
                    <a class="nav-link" asp-controller="Account" asp-action="Profile">
                        <i class="bi bi-person-circle"></i> Hồ sơ
                    </a>

                    <a class="nav-link text-danger" href="/Account/Logout">
                        <i class="bi bi-box-arrow-right"></i> Đăng xuất
                    </a>
                </nav>
            </div>
        </aside>

        <!-- ===== MAIN ===== -->
        <div class="staff-main d-flex flex-column">

            <!-- TOPBAR -->
            <div class="staff-topbar">
                <div class="fw-semibold">
                    @ViewData["Title"]
                </div>
                <div class="text-muted">
                    👤 @User.Identity?.Name
                </div>
            </div>

            <!-- CONTENT -->
            <div class="staff-content">
                <div class="staff-card">
                    <div class="staff-card-title">
                        @ViewData["Title"]
                    </div>
                    @RenderBody()
                </div>
            </div>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
