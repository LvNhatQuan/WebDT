@model List<WebDT.Areas.Admin.Models.ShippingOrderAdmin>
@{
    ViewData["Title"] = "Quản lý giao hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>#</th>
            <th>Người nhận</th>
            <th>SĐT</th>
            <th>Địa chỉ</th>
            <th>Tổng tiền</th>
            <th>Ngày đặt</th>
            <th>Trạng thái</th>
            <th width="200">Xử lý</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var o in Model)
        {
            <tr>
                <td>@o.Id</td>
                <td>@o.ReceiverName</td>
                <td>@o.ReceiverPhone</td>
                <td>@o.ShippingAddress</td>
                <td>@o.GrandTotal.ToString("N0") đ</td>
                <td>@o.OrderDate.ToString("dd/MM/yyyy")</td>
                <td>
                    <span class="badge bg-info">@o.Status</span>
                </td>
                <td>
                    <form asp-action="UpdateStatus" method="post" class="d-flex gap-1">
                        <input type="hidden" name="id" value="@o.Id" />
                        <select name="status" class="form-select form-select-sm">
                            <option value="processing">Đang chuẩn bị</option>
                            <option value="shipped">Đang giao</option>
                            <option value="completed">Hoàn thành</option>
                        </select>
                        <button class="btn btn-edit btn-sm">OK</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
