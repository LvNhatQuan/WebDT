@{
    var coupon = ViewBag.Coupon ?? Model.Coupon;
    var products = ViewBag.Products ?? Model.Products;
    var productCount = ViewBag.ProductCount ?? Model.ProductCount;
}

<h2 class="h4 mb-3 text-danger">Xóa mã giảm giá</h2>

@if (productCount > 0)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <strong>Cảnh báo:</strong> Có @productCount sản phẩm đang áp dụng mã giảm giá này.
        Nếu xóa, các sản phẩm này sẽ không còn được giảm giá.
    </div>
}
else
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle-fill"></i>
        Bạn có chắc chắn muốn xóa mã giảm giá này không?
    </div>
}

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Mã ID</dt>
            <dd class="col-sm-8">@coupon.Id</dd>

            <dt class="col-sm-4">Tên sự kiện</dt>
            <dd class="col-sm-8">@coupon.EventName</dd>

            <dt class="col-sm-4">Giảm giá</dt>
            <dd class="col-sm-8">@coupon.DiscountValue%</dd>

            <dt class="col-sm-4">Ngày bắt đầu</dt>
            <dd class="col-sm-8">@coupon.StartDate.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-4">Ngày kết thúc</dt>
            <dd class="col-sm-8">@coupon.EndDate.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-4">Trạng thái</dt>
            <dd class="col-sm-8">
                @if (coupon.IsActive)
                {
                    <span class="badge bg-success">Đang hoạt động</span>
                }
                else
                {
                    <span class="badge bg-secondary">Không hoạt động</span>
                }
            </dd>

            <dt class="col-sm-4">Số sản phẩm áp dụng</dt>
            <dd class="col-sm-8">
                <span class="badge bg-info">@productCount sản phẩm</span>
            </dd>
        </dl>

        @if (productCount > 0)
        {
            <div class="alert alert-info mt-3">
                <i class="bi bi-info-circle-fill"></i>
                <strong>Lưu ý:</strong> Nếu mã giảm giá đang được sử dụng trong sản phẩm,
                hệ thống sẽ chỉ vô hiệu hóa (không xóa hoàn toàn).
            </div>
        }
    </div>
</div>

<form asp-area="Admin" asp-controller="CouponAdmin" asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@coupon.Id" />

    @if (productCount > 0)
    {
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="confirmDelete" required>
            <label class="form-check-label text-danger" for="confirmDelete">
                Tôi hiểu rằng @productCount sản phẩm sẽ bị ảnh hưởng và đồng ý xóa
            </label>
        </div>
    }

    <button type="submit" class="btn btn-danger"
            @(productCount > 0 ? "disabled" : "")
            id="deleteButton">
        Xác nhận xóa
    </button>
    <a asp-area="Admin" asp-controller="CouponAdmin" asp-action="Index"
       class="btn btn-secondary ms-1">Hủy bỏ</a>
</form>

@if (productCount > 0)
{
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const checkbox = document.getElementById('confirmDelete');
            const deleteButton = document.getElementById('deleteButton');

            checkbox.addEventListener('change', function() {
                deleteButton.disabled = !this.checked;
            });
        });
    </script>
}
