@{
    var coupon = ViewBag.Coupon as WebDT.Areas.Admin.Models.CouponAdmin;
    var productCount = ViewBag.ProductCount ?? 0;
}

<h2 class="h4 mb-3 text-danger">Xóa mã giảm giá</h2>

@if (productCount > 0)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <strong>Cảnh báo:</strong> Mã giảm giá này đang được sử dụng trong hệ thống.
        Nếu xóa, mã sẽ được vô hiệu hóa và gỡ khỏi tất cả sản phẩm.
    </div>
}
else
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle-fill"></i>
        Bạn có chắc chắn muốn xóa mã giảm giá này không?
    </div>
}

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Mã ID</dt>
            <dd class="col-sm-8">@coupon.Id</dd>

            <dt class="col-sm-4">Tên sự kiện</dt>
            <dd class="col-sm-8">@coupon.EventName</dd>

            <dt class="col-sm-4">Giảm giá</dt>
            <dd class="col-sm-8">@coupon.DiscountValue%</dd>

            <dt class="col-sm-4">Ngày bắt đầu</dt>
            <dd class="col-sm-8">@coupon.StartDate.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-4">Ngày kết thúc</dt>
            <dd class="col-sm-8">@coupon.EndDate.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-4">Trạng thái</dt>
            <dd class="col-sm-8">
                @if (coupon.IsActive)
                {
                    <span class="badge bg-success">Đang hoạt động</span>
                }
                else
                {
                    <span class="badge bg-secondary">Không hoạt động</span>
                }
            </dd>

            <dt class="col-sm-4">Số sản phẩm áp dụng</dt>
            <dd class="col-sm-8">
                <span class="badge bg-info">@productCount sản phẩm</span>
            </dd>
        </dl>

        @if (productCount > 0)
        {
            <div class="alert alert-info mt-3">
                <i class="bi bi-info-circle-fill"></i>
                <strong>Lưu ý:</strong> Vì mã giảm giá đang được sử dụng, hệ thống sẽ:
                <ul class="mb-0 mt-2">
                    <li>Vô hiệu hóa mã giảm giá</li>
                    <li>Gỡ mã khỏi tất cả sản phẩm</li>
                    <li>Gỡ mã khỏi giỏ hàng của khách</li>
                    <li>Giữ lại lịch sử trong đơn hàng đã đặt</li>
                </ul>
            </div>
        }
    </div>
</div>

<form asp-area="Admin" asp-controller="CouponAdmin" asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@coupon.Id" />
    <input type="hidden" name="confirm" value="true" />

    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="confirmDelete" required>
        <label class="form-check-label text-danger" for="confirmDelete">
            @if (productCount > 0)
            {
                <span>Tôi hiểu rằng mã giảm giá sẽ được vô hiệu hóa và gỡ khỏi tất cả sản phẩm, giỏ hàng</span>
            }
            else
            {
                <span>Tôi hiểu rằng mã giảm giá sẽ bị xóa vĩnh viễn khỏi hệ thống</span>
            }
        </label>
    </div>

    <button type="submit" class="btn btn-danger"
            disabled
            id="deleteButton">
        @if (productCount > 0)
        {
            <span>Vô hiệu hóa mã giảm giá</span>
        }
        else
        {
            <span>Xóa vĩnh viễn</span>
        }
    </button>
    <a asp-area="Admin" asp-controller="CouponAdmin" asp-action="Index"
       class="btn btn-secondary ms-1">Hủy bỏ</a>
</form>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const checkbox = document.getElementById('confirmDelete');
        const deleteButton = document.getElementById('deleteButton');

        checkbox.addEventListener('change', function() {
            deleteButton.disabled = !this.checked;
        });
    });
</script>