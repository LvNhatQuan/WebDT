﻿@{
    var coupon = ViewBag.Coupon ?? Model.Coupon;
    var products = ViewBag.Products ?? Model.Products;
    var productCount = ViewBag.ProductCount ?? Model.ProductCount;
}

<h2 class="h4 mb-3">Chi tiết mã giảm giá</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Mã ID</dt>
                    <dd class="col-sm-8">@coupon.Id</dd>

                    <dt class="col-sm-4">Tên sự kiện</dt>
                    <dd class="col-sm-8">@coupon.EventName</dd>

                    <dt class="col-sm-4">Giảm giá</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-primary fs-6">@coupon.DiscountValue%</span>
                    </dd>

                    <dt class="col-sm-4">Ngày bắt đầu</dt>
                    <dd class="col-sm-8">@coupon.StartDate.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-4">Ngày kết thúc</dt>
                    <dd class="col-sm-8">@coupon.EndDate.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-4">Thời gian còn lại</dt>
                    <dd class="col-sm-8">
                        @{
                            var now = DateTime.Now;
                            if (coupon.StartDate > now)
                            {
                                var daysLeft = (coupon.StartDate - now).Days;
                                <span class="text-info">Sắp diễn ra (còn @daysLeft ngày)</span>
                            }
                            else if (coupon.EndDate < now)
                            {
                                <span class="text-warning">Đã hết hạn</span>
                            }
                            else
                            {
                                var daysLeft = (coupon.EndDate - now).Days;
                                <span class="text-success">Còn @daysLeft ngày</span>
                            }
                        }
                    </dd>

                    <dt class="col-sm-4">Trạng thái</dt>
                    <dd class="col-sm-8">
                        @if (coupon.IsActive)
                        {
                            <span class="badge bg-success">Đang hoạt động</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Không hoạt động</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Số sản phẩm áp dụng</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-info">@productCount sản phẩm</span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-light">
                <h5 class="mb-0">Danh sách sản phẩm áp dụng (@productCount)</h5>
            </div>
            <div class="card-body p-0">
                @if (products != null && products.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Tên sản phẩm</th>
                                    <th class="text-end">Giá</th>
                                    <th class="text-center">Tồn kho</th>
                                    <th class="text-center">Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int productIndex = 1;
                                }
                                @foreach (var product in products)
                                {
                                    <tr>
                                        <td>@productIndex</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                @if (!string.IsNullOrEmpty(product.ImageUrl))
                                                {
                                                    <img src="~/Images/SanPham/@product.ImageUrl" alt="@product.Name"
                                                         style="width:40px;height:40px;object-fit:cover;margin-right:10px;">
                                                }
                                                <div>
                                                    <div class="fw-medium">@product.Name</div>
                                                    <small class="text-muted">@product.CategoryName</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-end">@String.Format("{0:N0}", product.Price)</td>
                                        <td class="text-center">@product.StockQuantity</td>
                                        <td class="text-center">
                                            @if (product.IsActive)
                                            {
                                                <span class="badge bg-success">Đang bán</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Ngừng bán</span>
                                            }
                                        </td>
                                    </tr>
                                    productIndex++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="bi bi-box text-muted" style="font-size:3rem;"></i>
                        <p class="text-muted mt-2">Chưa có sản phẩm nào áp dụng mã giảm giá này</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-area="Admin" asp-controller="CouponAdmin" asp-action="Edit"
       asp-route-id="@coupon.Id" class="btn btn-primary">Sửa</a>
    <a asp-area="Admin" asp-controller="CouponAdmin" asp-action="Index"
       class="btn btn-secondary ms-1">Quay lại</a>
</div>
