@model List<WebDT.Areas.Admin.Models.CouponAdmin>
﻿@{
    ViewData["Title"] = "Quản lý mã giảm giá";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 mb-0">Mã giảm giá</h2>
    <a asp-area="Admin" asp-controller="CouponAdmin" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Thêm mới
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Tên sự kiện</th>
                            <th class="text-center">Giảm giá</th>
                            <th>Thời gian</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="pe-3" style="width: 180px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var isExpired = item.EndDate < DateTime.Now;
                            var isUpcoming = item.StartDate > DateTime.Now;
                            
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-medium">@item.EventName</div>
                                    <div class="small text-muted">
                                        #@item.Id • 
                                        @item.StartDate.ToString("dd/MM/yyyy") - @item.EndDate.ToString("dd/MM/yyyy")
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-primary">@item.DiscountValue%</span>
                                </td>
                                <td>
                                    <div>Bắt đầu: @item.StartDate.ToString("HH:mm dd/MM")</div>
                                    <div>Kết thúc: @item.EndDate.ToString("HH:mm dd/MM")</div>
                                </td>
                                <td class="text-center">
                                    @if (isExpired)
                                    {
                                        <span class="badge bg-secondary">Hết hạn</span>
                                    }
                                    else if (isUpcoming)
                                    {
                                        <span class="badge bg-info">Sắp tới</span>
                                    }
                                    else if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Đang chạy</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Tắt</span>
                                    }
                                </td>
                                <td class="pe-3">
                                    <div class="d-flex gap-1">
                                        <a asp-area="Admin" asp-controller="CouponAdmin" asp-action="Edit"
                                           asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="ToggleStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                                    title="@(item.IsActive ? "Tắt" : "Bật")">
                                                @if (item.IsActive)
                                                {
                                                    <i class="bi bi-toggle-on"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-toggle-off"></i>
                                                }
                                            </button>
                                        </form>
                                        <a asp-area="Admin" asp-controller="CouponAdmin" asp-action="Delete"
                                           asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-tag text-muted" style="font-size: 3rem;"></i>
                <p class="text-muted mt-3">Chưa có mã giảm giá nào</p>
                <a asp-area="Admin" asp-controller="CouponAdmin" asp-action="Create" 
                   class="btn btn-primary mt-2">
                    <i class="bi bi-plus-circle"></i> Tạo mã đầu tiên
                </a>
            </div>
        }
    </div>
</div>

<style>
    .table th {
        font-weight: 600;
        font-size: 0.875rem;
        text-transform: uppercase;
        color: #6c757d;
        border-bottom: 2px solid #dee2e6;
    }
    
    .table td {
        vertical-align: middle;
        padding: 0.75rem;
    }
    
    .btn-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
    }
    
    .badge {
        font-weight: 500;
        padding: 0.35em 0.65em;
        font-size: 0.75em;
    }
</style>

@section Scripts {
    <script>
        // Xác nhận trước khi thay đổi trạng thái
        document.querySelectorAll('form[asp-action="ToggleStatus"] button').forEach(button => {
            button.addEventListener('click', function(e) {
                if (!confirm('Bạn có chắc chắn muốn thay đổi trạng thái mã giảm giá này?')) {
                    e.preventDefault();
                }
            });
        });
    </script>
}