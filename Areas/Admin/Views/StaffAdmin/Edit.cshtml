@model WebDT.Areas.Admin.Models.StaffAdmin
@{
    ViewData["Title"] = "Cập nhật nhân viên";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">Username</label>
        <input class="form-control" value="@Model.Username" disabled />
    </div>

    <div class="mb-3">
        <label class="form-label">Email</label>
        <input class="form-control" value="@Model.Email" disabled />
    </div>

    <div class="mb-3">
        <label class="form-label">Họ tên</label>
        <input asp-for="FullName" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Số điện thoại</label>
        <input asp-for="PhoneNumber" class="form-control" />
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsLocked" class="form-check-input" />
        <label class="form-check-label">Khóa tài khoản</label>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-edit">
            <i class="bi bi-save"></i> Cập nhật
        </button>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </div>
</form>
