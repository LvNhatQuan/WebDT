@{
    ViewData["Title"] = "Giới thiệu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/introduce.css" />
}

<div class="introduce-page">
    <!-- Banner đầu trang -->
    <section class="intro-banner">
        <img src="~/Images/Introduce.jpg" alt="Banner giới thiệu DT Group" class="banner-image" />
    </section>

    <!-- 5 giá trị cốt lõi -->
    <section class="core-values-section">
        <div class="values-container">
            <div class="value-item">
                <div class="value-icon">
                    <img src="~/images/cn.jpg" alt="Chứng nhận an toàn" />
                </div>
                <h3 class="value-title">Chứng nhận an toàn</h3>
            </div>
            <div class="value-item">
                <div class="value-icon">
                    <img src="~/images/sp.jpg" alt="Sản phẩm chất lượng" />
                </div>
                <h3 class="value-title">Sản phẩm chất lượng</h3>
            </div>
            <div class="value-item">
                <div class="value-icon">
                    <img src="~/images/gt.jpg" alt="Giá thành hợp lý" />
                </div>
                <h3 class="value-title">Giá thành hợp lý</h3>
            </div>
            <div class="value-item">
                <div class="value-icon">
                    <img src="~/images/ng.jpg" alt="Nguồn gốc minh bạch" />
                </div>
                <h3 class="value-title">Nguồn gốc minh bạch</h3>
            </div>
            <div class="value-item">
                <div class="value-icon">
                    <img src="~/images/pt.jpg" alt="Phát triển bền vững" />
                </div>
                <h3 class="value-title">Phát triển bền vững</h3>
            </div>
        </div>
    </section>

    <!-- Timeline phát triển -->
    <section class="timeline-section">
        <!-- Mốc 2010 -->
        <div class="timeline-item">
            <div class="timeline-marker">
                <div class="marker-pin"></div>
                <div class="marker-date">10/2010</div>
            </div>
            <div class="timeline-content">
                <div class="row align-items-center">
                    <div class="col-lg-6">
                        <img src="~/images/sukien.jpg" alt="Thành lập DT Group" class="timeline-image" />
                    </div>
                    <div class="col-lg-6">
                        <p class="timeline-text">
                            DT Group được thành lập chuyên sản xuất, phân phối và kinh doanh thương mại
                            các loại thực phẩm, mỹ phẩm làm đẹp từ nguyên liệu thiên nhiên.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mốc 2012 -->
        <div class="timeline-item reverse">
            <div class="timeline-marker">
                <div class="marker-pin"></div>
                <div class="marker-date">2012</div>
            </div>
            <div class="timeline-content">
                <div class="row align-items-center">
                    <div class="col-lg-6">
                        <p class="timeline-text text-end">
                            Thực hiện dự án liên kết với các đơn vị nuôi trồng rong nho, kết hợp chuyên môn
                            từ trường Đại học Nha Trang và các trường đại học ở TP.HCM nhằm đầu tư thử nghiệm
                            3ha với sản lượng 2,5 tấn mỗi ha ở xã Ninh Phú (thị xã Ninh Hòa).
                        </p>
                    </div>
                    <div class="col-lg-6">
                        <img src="~/images/duan.jpg" alt="Dự án rong nho 2012" class="timeline-image" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Mốc 2014 -->
        <div class="timeline-item">
            <div class="timeline-marker">
                <div class="marker-pin"></div>
                <div class="marker-date">2014</div>
            </div>
            <div class="timeline-content">
                <div class="row align-items-center">
                    <div class="col-lg-6">
                        <img src="~/images/cgnb.jpg" alt="Chuyên gia Nhật Bản 2014" class="timeline-image" />
                    </div>
                    <div class="col-lg-6">
                        <p class="timeline-text">
                            Đoàn chuyên gia từ Nhật Bản đến thăm và kiểm nghiệm rong nho (thông qua chương trình
                            hợp tác) với kết quả tốt hơn rong nho ở "thủ phủ" Okinawa đã nhận được lời đề nghị
                            xuất khẩu sản phẩm sang thị trường Nhật Bản.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mốc 2021 -->
        <div class="timeline-item reverse">
            <div class="timeline-marker">
                <div class="marker-pin"></div>
                <div class="marker-date">2021</div>
            </div>
            <div class="timeline-content">
                <div class="row align-items-center">
                    <div class="col-lg-6">
                        <p class="timeline-text text-end">
                            DT Group đã xuất khẩu sang 2 thị trường chính là Mỹ và Nhật Bản với sản lượng
                            trung bình là 40 tấn rong nho/tháng.
                        </p>
                    </div>
                    <div class="col-lg-6">
                        <img src="~/images/xuatkhau.jpg" alt="Xuất khẩu 2021" class="timeline-image" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Sứ mệnh -->
    <section class="mission-section">
        <h2 class="mission-title">SỨ MỆNH CỦA CHÚNG TÔI</h2>

        <div class="mission-grid">
            <div class="mission-item">
                <div class="mission-icon">
                    <div class="icon-circle">
                        <!-- Icon handshake -->
                        <img src="@Url.Content("~/Images/Frame 40.png")"
                             alt="Handshake Icon"
                             width="78"
                             height="78"
                             style="object-fit: contain;" />
                    </div>
                </div>
                <h3 class="mission-item-title">ĐỐI TÁC</h3>
                <p class="mission-item-text">Là đối tác tin cậy và đem lại lợi nhuận lâu dài</p>
            </div>

            <div class="mission-item">
                <div class="mission-icon">
                    <div class="icon-circle">
                        <!-- Icon globe-users -->
                        <img src="@Url.Content("~/Images/Frame 41.png")"
                             alt="Handshake Icon"
                             width="78"
                             height="78"
                             style="object-fit: contain;" />
                    </div>
                </div>
                <h3 class="mission-item-title">KHÁCH HÀNG</h3>
                <p class="mission-item-text">Là nhà cung cấp sản phẩm chất lượng và tin cậy</p>
            </div>

            <div class="mission-item">
                <div class="mission-icon">
                    <div class="icon-circle">
                        <!-- Icon balance -->
                        <img src="@Url.Content("~/Images/Frame 42.png")"
                             alt="Handshake Icon"
                             width="78"
                             height="78"
                             style="object-fit: contain;" />
                    </div>
                </div>
                <h3 class="mission-item-title">XÃ HỘI</h3>
                <p class="mission-item-text">Là ngôi nhà chia sẻ những giá trị chung</p>
            </div>

            <div class="mission-item">
                <div class="mission-icon">
                    <div class="icon-circle">
                        <!-- Icon hand-heart -->
                        <img src="@Url.Content("~/Images/Frame 43.png")"
                             alt="Handshake Icon"
                             width="78"
                             height="78"
                             style="object-fit: contain;" />
                    </div>
                </div>
                <h3 class="mission-item-title">NHÂN VIÊN</h3>
                <p class="mission-item-text">Là thành viên tích cực và có trách nhiệm cao</p>
            </div>
        </div>
    </section>
</div>