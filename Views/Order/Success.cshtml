@model OrderModel
@using System.Globalization

@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="text-center my-5">
    <h2 class="text-success">🎉 Đặt hàng thành công!</h2>
    <p>Cảm ơn bạn đã mua sắm tại DT Shop</p>
</div>

<div class="card mb-4">
    <div class="card-header fw-bold">Thông tin đơn hàng</div>
    <div class="card-body">
        <p><strong>Mã đơn:</strong> #@Model.Id</p>
        <p><strong>Người nhận:</strong> @Model.ReceiverName</p>
        <p><strong>SĐT:</strong> @Model.ReceiverPhone</p>
        <p><strong>Địa chỉ:</strong> @Model.ShippingAddress</p>
        <p><strong>Ngày đặt:</strong> @Model.OrderDate</p>
    </div>
</div>

<table class="table table-bordered">
    <thead class="table-light">
        <tr>
            <th>Sản phẩm</th>
            <th>SL</th>
            <th>Giá</th>
            <th>Tạm tính</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Quantity</td>
                <td>
                    @string.Format(CultureInfo.GetCultureInfo("vi-VN"), "{0:N0} đ", item.Price)
                </td>
                <td class="text-danger fw-bold">
                    @string.Format(CultureInfo.GetCultureInfo("vi-VN"), "{0:N0} đ", item.Total)
                </td>
            </tr>
        }
    </tbody>
</table>

<h4 class="text-end text-danger">
    Tổng thanh toán:
    @string.Format(CultureInfo.GetCultureInfo("vi-VN"), "{0:N0} đ", Model.GrandTotal)
</h4>

<div class="text-center mt-4">
    <a href="/Product" class="btn btn-primary">
        Tiếp tục mua sắm
    </a>
</div>
