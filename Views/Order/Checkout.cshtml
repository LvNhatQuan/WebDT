@model CheckoutViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Thanh toán";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
}

<h3 class="mb-4 fw-bold">📦 Xác nhận đặt hàng</h3>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<form asp-action="PlaceOrder" method="post">
    @Html.AntiForgeryToken()

    <div class="row">
        <!-- ================= THÔNG TIN NHẬN HÀNG ================= -->
        <div class="col-md-6">
            <div class="card mb-4 shadow-sm">
                <div class="card-header fw-bold">Thông tin người nhận</div>
                <div class="card-body">

                    <div class="mb-3">
                        <label class="form-label">Người nhận</label>
                        <input name="receiverName"
                               class="form-control"
                               placeholder="Họ tên người nhận"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Số điện thoại</label>
                        <input name="receiverPhone"
                               class="form-control"
                               placeholder="Số điện thoại liên hệ"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Địa chỉ giao hàng</label>
                        <textarea name="shippingAddress"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Nhập địa chỉ giao hàng"
                                  required></textarea>
                    </div>

                    <!-- ===== PHƯƠNG THỨC THANH TOÁN ===== -->
                    <div class="mb-2">
                        <label class="form-label fw-bold">Phương thức thanh toán</label>

                        <div class="form-check">
                            <input class="form-check-input"
                                   type="radio"
                                   name="paymentMethod"
                                   value="cod"
                                   checked />
                            <label class="form-check-label">
                                Thanh toán khi nhận hàng (COD)
                            </label>
                        </div>

                        <div class="form-check mt-1">
                            <input class="form-check-input"
                                   type="radio"
                                   name="paymentMethod"
                                   value="bank" />
                            <label class="form-check-label">
                                Chuyển khoản ngân hàng
                            </label>
                        </div>

                        <small class="text-muted">
                            (Nếu chọn chuyển khoản, chúng tôi sẽ liên hệ xác nhận)
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= ĐƠN HÀNG ================= -->
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header fw-bold">Đơn hàng</div>
                <div class="card-body">

                    <ul class="list-group mb-3">
                        @foreach (var item in Model.CartItems)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <div>
                                    @item.Name
                                    <br />
                                    <small class="text-muted">x @item.Quantity</small>
                                </div>
                                <span>
                                    @string.Format(culture, "{0:N0} đ", item.Total)
                                </span>
                            </li>
                        }
                    </ul>

                    <!-- ===== MÃ GIẢM GIÁ ===== -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mã giảm giá (nếu có)</label>
                        <input name="couponCode"
                               class="form-control"
                               placeholder="Nhập mã giảm giá" />
                        <small class="text-muted">
                            Áp dụng nếu mã hợp lệ
                        </small>
                    </div>

                    <p class="d-flex justify-content-between">
                        <span>Phí ship:</span>
                        <span>
                            @string.Format(culture, "{0:N0} đ", Model.ShippingFee)
                        </span>
                    </p>

                    <hr />

                    <h5 class="d-flex justify-content-between text-danger">
                        <span>Tổng cộng:</span>
                        <span class="fw-bold">
                            @string.Format(
                                culture,
                                "{0:N0} đ",
                                Model.CartItems.Sum(x => x.Total) + Model.ShippingFee
                            )
                        </span>
                    </h5>

                    <button type="submit"
                            class="btn btn-danger btn-lg w-100 mt-3">
                        ✔ XÁC NHẬN ĐẶT HÀNG
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>
