@model WebDT.Models.CheckoutViewModel

@{
    ViewData["Title"] = "Thanh toán";
}

<div class="container py-5">
    <h2 class="mb-4">🧾 Xác nhận đơn hàng</h2>

    @if (Model == null || !Model.CartItems.Any())
    {
        <div class="alert alert-warning">
            Giỏ hàng trống, không thể thanh toán.
        </div>
        <a asp-controller="Cart"
           asp-action="Index"
           class="btn btn-primary">
            ⬅️ Quay lại giỏ hàng
        </a>
    }
    else
    {
        <!-- DANH SÁCH SẢN PHẨM -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Giá</th>
                        <th>Số lượng</th>
                        <th class="text-end">Tổng</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.CartItems)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="~/images/SanPham/@item.Img"
                                         class="me-3 rounded"
                                         style="width:60px;height:60px"
                                         alt="@item.Name" />
                                    <strong>@item.Name</strong>
                                </div>
                            </td>
                            <td>@item.Price.ToString("#,##0 VND")</td>
                            <td>@item.Quantity</td>
                            <td class="text-end text-danger fw-bold">
                                @item.Total.ToString("#,##0 VND")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- TỔNG TIỀN -->
        <div class="row justify-content-end mb-4">
            <div class="col-md-5">
                <ul class="list-group">
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Tạm tính</span>
                        <strong>@Model.SubTotal.ToString("#,##0 VND")</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Phí vận chuyển</span>
                        <strong>@Model.ShippingFee.ToString("#,##0 VND")</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Giảm giá</span>
                        <strong>@Model.Discount.ToString("#,##0 VND")</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between fs-5">
                        <span>Tổng thanh toán</span>
                        <span class="text-danger fw-bold">
                            @Model.GrandTotal.ToString("#,##0 VND")
                        </span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- FORM ĐẶT HÀNG -->
        <form asp-controller="Order"
              asp-action="PlaceOrder"
              method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Địa chỉ giao hàng</label>
                <textarea name="shippingAddress"
                      class="form-control"
                      rows="3"
                      required
                      placeholder="Nhập địa chỉ giao hàng"></textarea>
            </div>

            <!-- Coupon (tuỳ chọn) -->
            <div class="mb-4">
                <label class="form-label">Mã giảm giá (nếu có)</label>
                <input type="number"
                       name="couponId"
                       class="form-control"
                       placeholder="Nhập mã coupon" />
            </div>

            <div class="d-flex justify-content-between">
                <a asp-controller="Cart"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    ⬅️ Quay lại giỏ hàng
                </a>

                <button type="submit"
                        class="btn btn-success btn-lg">
                    <i class="fas fa-check-circle me-2"></i>
                    Xác nhận đặt hàng
                </button>
            </div>
        </form>
    }
</div>
