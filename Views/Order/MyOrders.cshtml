@* @model List<WebDT.Models.OrderModel>

<h3 class="mb-4">Đơn hàng của tôi</h3>

<table class="table table-bordered align-middle">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Ngày</th>
            <th>Tổng</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var o in Model)
        {
            <tr>
                <td>#@o.Id</td>
                <td>@o.OrderDate.ToString("dd/MM/yyyy")</td>
                <td>@o.GrandTotal.ToString("#,##0 đ")</td>
                <td>
                    <span class="badge @StatusClass(o.Status)">
                        @StatusText(o.Status)
                    </span>
                </td>
                <td class="d-flex gap-1">
                    <a asp-action="Detail"
                       asp-route-id="@o.Id"
                       class="btn btn-sm btn-outline-dark">
                        Chi tiết
                    </a>

                    @if (o.Status == "pending")
                    {
                        <form asp-action="Cancel" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@o.Id" />
                            <button class="btn btn-sm btn-danger">Hủy</button>
                        </form>
                    }

                    @if (o.Status == "shipping")
                    {
                        <form asp-action="ConfirmReceived" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@o.Id" />
                            <button class="btn btn-sm btn-success">Đã nhận</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@functions {
    string StatusText(string s) => s switch
    {
        "pending" => "Chờ xác nhận",
        "confirmed" => "Đã xác nhận",
        "shipping" => "Đang giao",
        "delivered" => "Đã giao",
        "cancelled" => "Đã hủy",
        _ => "?"
    };

    string StatusClass(string s) => s switch
    {
        "pending" => "bg-secondary",
        "confirmed" => "bg-primary",
        "shipping" => "bg-warning text-dark",
        "delivered" => "bg-success",
        "cancelled" => "bg-danger",
        _ => "bg-dark"
    };
} *@
