@model IEnumerable<WebDT.Models.CartItem>

<div class="container-fluid">
    <div class="container py-5">

        <!-- Alert Success -->
        @if (!string.IsNullOrWhiteSpace(TempData["CheckOutSuccessMessage"]?.ToString()))
        {
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                <strong><i class="fas fa-check-circle me-2"></i>Thành công!</strong>
                @TempData["CheckOutSuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Alert Error -->
        @if (!string.IsNullOrWhiteSpace(TempData["CheckOutErrorMessage"]?.ToString()))
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                <strong><i class="fas fa-exclamation-circle me-2"></i>Lỗi!</strong>
                @TempData["CheckOutErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <!-- CART TABLE -->
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Tên</th>
                            <th>Giá</th>
                            <th>Số lượng</th>
                            <th>Tổng</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr id="idProduct-@item.IdProduct">
                                <td>
                                    <img src="~/images/SanPham/@item.Img"
                                         class="img-fluid"
                                         style="width:80px;height:80px" />
                                </td>
                                <td>@item.Name</td>
                                <td>@item.Price.ToString("#,##0 VND")</td>
                                <td>
                                    <div class="input-group quantity" style="width:100px">
                                        <button class="btn btn-sm btn-minus rounded-circle bg-light border"
                                                onclick="clickBtnQuantity(@item.IdProduct,false)">
                                            <i class="fa fa-minus"></i>
                                        </button>
                                        <input type="number"
                                               class="form-control form-control-sm text-center border-0"
                                               value="@item.Quantity"
                                               min="1" />
                                        <button class="btn btn-sm btn-plus rounded-circle bg-light border"
                                                onclick="clickBtnQuantity(@item.IdProduct,true)">
                                            <i class="fa fa-plus"></i>
                                        </button>
                                    </div>
                                </td>
                                <td id="totalProduct-@item.IdProduct"
                                    class="text-danger fw-bold">
                                    @item.Total.ToString("#,##0 VND")
                                </td>
                                <td>
                                    <button class="btn btn-md rounded-circle bg-light border"
                                            onclick="clickDeleteProduct(@item.IdProduct)">
                                        <i class="fa fa-times text-danger"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- TOTAL + CHECKOUT -->
            <div class="row g-4 justify-content-end">
                <div class="col-sm-8 col-md-7 col-lg-6 col-xl-4">
                    <div class="bg-light rounded">
                        <div class="py-4 mb-4 border-top border-bottom d-flex justify-content-between">
                            <h5 class="mb-0 ps-4 me-4">Tổng tiền</h5>
                            <p class="mb-0 pe-4 fw-bold">
                                @Model.Sum(p => p.Total).ToString("#,##0 VND")
                            </p>
                        </div>

                        <!-- 🔥 NÚT THANH TOÁN – CHUYỂN TRANG -->
                        <a href="/Order/Checkout"
                           class="btn border-secondary rounded-pill px-4 py-3 text-uppercase mb-4 ms-4">
                            <i class="fas fa-credit-card me-2"></i>
                            Thanh toán
                        </a>


                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- EMPTY CART -->
            <div class="text-center py-5">
                <i class="fas fa-shopping-cart fa-5x text-muted mb-4"></i>
                <h4>Giỏ hàng của bạn đang trống</h4>
                <p class="text-muted">Hãy thêm sản phẩm để tiếp tục</p>
                <a href="/Product" class="btn btn-primary btn-lg mt-3">
                    <i class="fas fa-shopping-bag me-2"></i>
                    Tiếp tục mua sắm
                </a>
            </div>
        }
    </div>
</div>

<script>
    // Auto close alert
    window.setTimeout(function () {
        $(".alert").fadeTo(500, 0).slideUp(500, function () {
            $(this).remove();
        });
    }, 5000);
</script>
