@model List<WebDT.Models.CartItem>
@using System.Globalization

@{
    ViewData["Title"] = "Giỏ hàng";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
    decimal total = Model.Sum(x => x.Total);
}

<h3 class="mb-4 fw-bold">🛒 Giỏ hàng của bạn</h3>

@if (!Model.Any())
{
    <div class="alert alert-info shadow-sm">
        Giỏ hàng của bạn đang trống.
    </div>
    <a href="/Product" class="btn btn-primary">
        Tiếp tục mua sắm
    </a>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th width="100">Ảnh</th>
                        <th>Sản phẩm</th>
                        <th width="160">Số lượng</th>
                        <th width="150">Giá</th>
                        <th width="170">Tạm tính</th>
                        <th width="60"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">
                                <img src="@Url.Content("~/Images/SanPham/" + item.Img)"
                                     class="rounded border"
                                     style="width:80px;height:80px;object-fit:cover;" />
                            </td>

                            <td class="fw-semibold">
                                @item.Name
                            </td>

                            <td>
                                <form asp-action="Update" method="post" class="d-flex">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.IdProduct" />
                                    <input type="number"
                                           name="quantity"
                                           value="@item.Quantity"
                                           min="1"
                                           class="form-control me-2 text-center"
                                           style="max-width:80px;" />
                                    <button class="btn btn-outline-primary btn-sm">
                                        ✓
                                    </button>
                                </form>
                            </td>

                            <td>
                                @string.Format(culture, "{0:N0} đ", item.Price)
                            </td>

                            <td class="text-danger fw-bold">
                                @string.Format(culture, "{0:N0} đ", item.Total)
                            </td>

                            <td>
                                <form asp-action="Remove" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.IdProduct" />
                                    <button class="btn btn-danger btn-sm">
                                        ✕
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ===== TỔNG TIỀN ===== -->
    <div class="row justify-content-end mt-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="d-flex justify-content-between">
                        <span class="fw-semibold">Tổng cộng:</span>
                        <span class="text-danger fw-bold fs-5">
                            @string.Format(culture, "{0:N0} đ", total)
                        </span>
                    </h5>

                    <a href="/Order/Checkout"
                       class="btn btn-danger btn-lg w-100 mt-3">
                        Thanh toán →
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a href="/Product" class="btn btn-outline-secondary">
            ← Tiếp tục mua
        </a>
    </div>
}