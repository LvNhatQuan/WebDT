@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.Mvc.ViewComponents

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@(ViewData["Title"] ?? "DT Shop") - DT Shop</title>

    <!-- BOOTSTRAP & CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebD_T.styles.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    @RenderSection("Styles", required: false)

    <style>
        body {
            background: #f7f7f7;
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 20px;
        }
    </style>
</head>

<body>

    <!-- ================= NAVBAR ================= -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-light border-bottom box-shadow mb-3"
             style="background-color:#ffe4e1;">
            <div class="container-fluid">

                <!-- LOGO -->
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="/Images/d&t.jpg" alt="D&T Group" style="height:40px;">
                </a>

                <!-- TOGGLER -->
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- MENU -->
                <div class="collapse navbar-collapse justify-content-between" id="mainNavbar">
                    <ul class="navbar-nav">

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home" asp-action="Index">
                                TRANG CHỦ
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Introduce" asp-action="Index">
                                GIỚI THIỆU
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Product" asp-action="Index">
                                SẢN PHẨM
                            </a>
                        </li>

                       
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Contact"
                               asp-action="Index">
                                LIÊN HỆ
                            </a>
                        </li>

                    </ul>
                    <!-- CART + LOGIN -->
                    <div class="d-flex align-items-center gap-3">

                        @await Component.InvokeAsync("Cart")

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown">
                                <button class="btn btn-outline-dark dropdown-toggle rounded-pill"
                                        type="button"
                                        data-bs-toggle="dropdown">
                                    👤 @User.Identity.Name
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Account"
                                           asp-action="Profile">
                                            Thông tin cá nhân
                                        </a>
                                    </li>
                                    <li>
                                        <form asp-controller="Account"
                                              asp-action="Logout"
                                              method="get">
                                            <button class="dropdown-item text-danger" type="submit">
                                                Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account"
                               asp-action="Login"
                               class="btn btn-danger rounded-pill">
                                Đăng nhập
                            </a>
                        }

                    </div>

                </div>
            </div>
        </nav>
    </header>

    <!-- ================= MAIN ================= -->
    <main class="container mt-4">
        @RenderBody()
    </main>
    <footer class="border-top footer text-muted mt-auto" style="background:#FFD4CD; font-size:17px">
        <div class="container py-4">
            <div class="row g-4">
                <div class="col-12 col-sm-6 col-lg-2 text-center text-sm-start">
                    <img src="~/img/logo-dt-group.jpg" class="img-fluid" alt="Logo DT Group" style="height:150px; mix-blend-mode: multiply;" />
                </div>

                <div class="col-12 col-sm-6 col-lg-4">
                    <h2 class="fw-bold text-dark mb-3 text-center">CÔNG TY TNHH <br />DT GROUP</h2>
                    <p class="text-dark text-justify">
                        GPKD Số 4201794039 do Sở KH và ĐT TP Nha Trang cấp ngày 23/05/2018<br /><br />
                        Địa chỉ: KCN Đắc Lộc, Vĩnh Phương, Tp. Nha Trang, Khánh Hòa<br /><br />
                        Chuyên sản xuất, phân phối và kinh doanh thương mại các loại thực phẩm, mỹ phẩm làm đẹp từ nguyên liệu thiên nhiên – đặc sản của Việt Nam.
                    </p>
                    <p class="text-dark">© Bản quyền thuộc về DTGROUP</p>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <h2 class="fw-bold text-dark mb-3 text-center">CHÍNH SÁCH</h2>
                    <ul class="list-unstyled text-dark ms-5 mt-5">
                        <li class="mb-2"><a href="#" class="text-decoration-underline text-dark">Chính sách thanh toán</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-underline text-dark">Chính sách khiếu nại</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-underline text-dark">Chính sách vận chuyển</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-underline text-dark">Chính sách đổi trả và hoàn tiền</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-underline text-dark">Chính sách bảo hành</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-underline text-dark">Chính sách kiểm hàng</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-underline text-dark">Chính sách bảo mật thông tin</a></li>
                        <li><a href="#" class="text-decoration-underline text-dark">Đăng ký bộ công thương</a></li>
                    </ul>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <h2 class="fw-bold text-dark mb-3 text-center">LIÊN HỆ</h2>

                    <div class="d-flex align-items-start mb-3 mt-5">
                        <i class="fa-solid fa-house mt-1 me-2 text-dark"></i>
                        <p class="text-dark m-0">
                            KCN Đắc Lộc, Vĩnh Phương, Tp. Nha Trang, Khánh Hòa
                        </p>
                    </div>

                    <div class="d-flex align-items-center mb-3">
                        <i class="fa-solid fa-envelope me-2 text-dark"></i>
                        <p class="text-dark m-0">
                            info@dtvietnam.com
                        </p>
                    </div>

                    <div class="d-flex align-items-start">
                        <i class="fa-solid fa-phone mt-1 me-2 text-dark"></i>
                        <div class="text-dark">
                            <strong>Gọi mua:</strong> <br />0833.416.868<br />
                            <strong>Khiếu nại:</strong> <br />0847.236.868
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- ================= JS ================= -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>
