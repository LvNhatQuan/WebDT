@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.Mvc.ViewComponents

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@(ViewData["Title"] ?? "DT Shop") - DT Shop</title>

    <!-- BOOTSTRAP & CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebD_T.styles.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    @RenderSection("Styles", required: false)

    <style>
        body {
            background: #f7f7f7;
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 20px;
        }
    </style>
</head>

<body>

    <!-- ================= NAVBAR ================= -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-light border-bottom box-shadow mb-3"
             style="background-color:#ffe4e1;">
            <div class="container-fluid">

                <!-- LOGO -->
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="/Images/d&t.jpg" alt="D&T Group" style="height:40px; mix-blend-mode:multiply;">
                </a>

                <!-- TOGGLER -->
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- MENU -->
                <div class="collapse navbar-collapse justify-content-between" id="mainNavbar">
                    <ul class="navbar-nav">

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home" asp-action="Index">
                                TRANG CHỦ
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Introduce" asp-action="Index">
                                GIỚI THIỆU
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Product" asp-action="Index">
                                SẢN PHẨM
                            </a>
                        </li>


                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Contact"
                               asp-action="Index">
                                LIÊN HỆ
                            </a>
                        </li>

                    </ul>
                    <!-- CART + LOGIN -->
                    <div class="d-flex align-items-center gap-3">

                        @await Component.InvokeAsync("Cart")

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown">
                                <button class="btn btn-outline-dark dropdown-toggle rounded-pill"
                                        type="button"
                                        data-bs-toggle="dropdown">
                                    👤 @User.Identity.Name
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Account"
                                           asp-action="Profile">
                                            Thông tin cá nhân
                                        </a>
                                    </li>
                                    <li>
                                        <form asp-controller="Account"
                                              asp-action="Logout"
                                              method="get">
                                            <button class="dropdown-item text-danger" type="submit">
                                                Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account"
                               asp-action="Login"
                               class="btn btn-danger rounded-pill">
                                Đăng nhập
                            </a>
                        }

                    </div>

                </div>
            </div>
        </nav>
    </header>

    <!-- ================= MAIN ================= -->
    <main class="container mt-4">
        @RenderBody()
    </main>
    <footer class="border-top footer text-muted mt-auto" style="background:#FFD4CD; font-size:17px">
        <div class="container py-4">
            <div class="row g-4">

                <div class="col-12 col-lg-2 text-center text-lg-start">
                    <img src="~/img/logo-dt-group.jpg"
                         class="img-fluid rounded"
                         alt="Logo DT Group"
                         style="max-height:150px; mix-blend-mode: multiply;" />
                </div>

                <div class="col-12 col-md-6 col-lg-4 text-center text-lg-start">
                    <h5 class="fw-bold text-dark mb-3">CÔNG TY TNHH DT GROUP</h5>
                    <div class="text-dark">
                        <p class="mb-2">GPKD Số 4201794039 do Sở KH và ĐT TP Nha Trang cấp ngày 23/05/2018</p>
                        <p class="mb-2">Địa chỉ: KCN Đắc Lộc, Vĩnh Phương, Tp. Nha Trang, Khánh Hòa</p>
                        <p class="mb-2">Chuyên sản xuất, phân phối và kinh doanh thương mại các loại thực phẩm, mỹ phẩm làm đẹp từ nguyên liệu thiên nhiên – đặc sản của Việt Nam.</p>
                    </div>
                    <p class="text-dark fw-bold mt-3">© Bản quyền thuộc về DTGROUP</p>
                </div>

                <div class="col-12 col-md-6 col-lg-3 text-center text-lg-start">
                    <h5 class="fw-bold text-dark mb-3">CHÍNH SÁCH</h5>
                    <ul class="list-unstyled text-dark ps-0">
                        <li class="mb-2"><a href="/Home/Privacy#list-payment" class="text-decoration-none text-dark hover-link">Chính sách thanh toán</a></li>
                        <li class="mb-2"><a href="/Home/Privacy#list-complaint" class="text-decoration-none text-dark hover-link">Chính sách khiếu nại</a></li>
                        <li class="mb-2"><a href="/Home/Privacy#list-shipping" class="text-decoration-none text-dark hover-link">Chính sách vận chuyển</a></li>
                        <li class="mb-2"><a href="/Home/Privacy#list-return" class="text-decoration-none text-dark hover-link">Chính sách đổi trả & hoàn tiền</a></li>
                        <li class="mb-2"><a href="/Home/Privacy#list-warranty" class="text-decoration-none text-dark hover-link">Chính sách bảo hành</a></li>
                        <li class="mb-2"><a href="/Home/Privacy#list-inspection" class="text-decoration-none text-dark hover-link">Chính sách kiểm hàng</a></li>
                        <li class="mb-2"><a href="/Home/Privacy#list-privacy" class="text-decoration-none text-dark hover-link">Bảo mật thông tin</a></li>
                        <li class="mt-3">
                            <a href="http://online.gov.vn/Home/WebDetails/100511?AspxAutoDetectCookieSupport=1" target="_blank">
                                <span class="text-decoration-underline text-dark fw-bold">Đăng ký bộ công thương</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="col-12 col-md-6 col-lg-3 text-center text-lg-start">
                    <h5 class="fw-bold text-dark mb-3">LIÊN HỆ</h5>

                    <div class="d-flex flex-column align-items-center align-items-lg-start gap-3">
                        <div class="d-flex align-items-start">
                            <i class="fa-solid fa-house mt-1 me-2 text-danger"></i>
                            <span>KCN Đắc Lộc, Vĩnh Phương, Tp. Nha Trang, Khánh Hòa</span>
                        </div>

                        <div class="d-flex align-items-center">
                            <i class="fa-solid fa-envelope me-2 text-danger"></i>
                            <a href="mailto:info@dtvietnam.com" class="text-dark text-decoration-none">info@dtvietnam.com</a>
                        </div>

                        <div class="d-flex align-items-start">
                            <i class="fa-solid fa-phone mt-1 me-2 text-danger"></i>
                            <div>
                                <div><strong>Gọi mua:</strong> 0833.416.868</div>
                                <div><strong>Khiếu nại:</strong> 0847.236.868</div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </footer>

    <style>
        .hover-link:hover {
            color: #d32f2f !important; /* Màu đỏ đậm khi di chuột vào */
            text-decoration: underline !important;
        }
    </style>

    <!-- ================= JS ================= -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>
