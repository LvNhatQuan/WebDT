@model WebDT.Models.Address

@{
    ViewData["Title"] = "Thêm địa chỉ mới";
}

<div class="container">
    <h2>@ViewData["Title"]</h2>

    <form asp-action="Create">
        <div class="form-group">
            <label asp-for="address_line" class="control-label">Địa chỉ chi tiết</label>
            <input asp-for="address_line" class="form-control" />
            <span asp-validation-for="address_line" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="district" class="control-label">Quận/Huyện</label>
            <input asp-for="district" class="form-control" />
            <span asp-validation-for="district" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="city" class="control-label">Thành phố</label>
            <input asp-for="city" class="form-control" />
            <span asp-validation-for="city" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="phone_receiver" class="control-label">Số điện thoại người nhận</label>
            <input asp-for="phone_receiver" class="form-control" />
            <span asp-validation-for="phone_receiver" class="text-danger"></span>
        </div>

        <div class="form-group form-check">
            <input class="form-check-input" asp-for="is_default" />
            <label class="form-check-label" asp-for="is_default">Đặt làm địa chỉ mặc định</label>
        </div>

        <div class="form-group mt-3">
            <button type="submit" class="btn btn-primary">Thêm địa chỉ</button>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}