@model List<WebDT.Models.Address>

@{
    ViewData["Title"] = "Quản lý địa chỉ";
}

<div class="container mt-4">
    <h2>Địa chỉ giao hàng</h2>

    <!-- Hiển thị thông báo thanh toán thành công -->
    @if (!string.IsNullOrWhiteSpace(ViewBag.CheckOutSuccessMessage?.ToString()))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Thành công!</strong> @ViewBag.CheckOutSuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Hiển thị thông báo lỗi thanh toán -->
    @if (!string.IsNullOrWhiteSpace(ViewBag.CheckOutErrorMessage?.ToString()))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Lỗi!</strong> @ViewBag.CheckOutErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Hiển thị thông báo thành công từ AddressController -->
    @if (!string.IsNullOrWhiteSpace(ViewBag.SuccessMessage?.ToString()))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Thành công!</strong> @ViewBag.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Hiển thị thông báo lỗi từ AddressController -->
    @if (!string.IsNullOrWhiteSpace(ViewBag.ErrorMessage?.ToString()))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Lỗi!</strong> @ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Hiển thị thông báo khi chưa có địa chỉ -->
    @if (!string.IsNullOrWhiteSpace(ViewBag.NoAddressMessage?.ToString()))
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @ViewBag.NoAddressMessage
        </div>
    }

    <div class="d-flex justify-content-between mb-3">
        <a href="/Cart/Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i> Quay lại giỏ hàng
        </a>
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Thêm địa chỉ mới
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var address in Model)
            {
                <div class="col-md-6 mb-3">
                    <div class="card h-100 @(address.is_default ? "border-primary" : "")">
                        <div class="card-body">
                            @if (address.is_default)
                            {
                                <span class="badge bg-primary mb-2">Mặc định</span>
                            }

                            <h5 class="card-title">Địa chỉ giao hàng</h5>
                            <p class="card-text">
                                <strong>Địa chỉ:</strong> @address.address_line<br>
                                <strong>Quận/Huyện:</strong> @address.district<br>
                                <strong>Thành phố:</strong> @address.city<br>
                                <strong>Điện thoại người nhận:</strong> @address.phone_receiver
                            </p>

                            <div class="d-flex gap-2">
                                @if (!address.is_default)
                                {
                                    <form method="post" action="@Url.Action("SetDefault", new { id = address.id })"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-primary btn-sm">
                                            <i class="fas fa-check-circle me-1"></i> Đặt làm mặc định
                                        </button>
                                    </form>
                                }

                                <a href="@Url.Action("Edit", new { id = address.id })"
                                   class="btn btn-outline-secondary btn-sm">
                                    <i class="fas fa-edit me-1"></i> Sửa
                                </a>

                                @if (!address.is_default)
                                {
                                    <form method="post" action="@Url.Action("Delete", new { id = address.id })"
                                          class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc chắn muốn xóa địa chỉ này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            <i class="fas fa-trash me-1"></i> Xóa
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-map-marker-alt fa-4x text-muted mb-3"></i>
            <h4>Bạn chưa có địa chỉ nào</h4>
            <p class="text-muted">Hãy thêm địa chỉ giao hàng để có thể thanh toán đơn hàng</p>
            <a href="@Url.Action("Create")" class="btn btn-primary btn-lg">
                <i class="fas fa-plus me-2"></i> Thêm địa chỉ đầu tiên
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Tự động đóng alert sau 5 giây
        setTimeout(function() {
            $('.alert').fadeTo(500, 0).slideUp(500, function(){
                $(this).remove();
            });
        }, 5000);
    </script>
}