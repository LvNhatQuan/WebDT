@model WebDT.Models.ProductPagination
@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<h2 class="mb-4">Danh sách sản phẩm</h2>

<div class="row">
    @foreach (var p in Model.Products)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">

                <!-- IMAGE -->
                <img src="~/Images/SanPham/@p.ImageUrl"
                     alt="@p.Name"
                     class="card-img-top"
                     style="height:220px; object-fit:cover"
                     onerror="this.src='/Images/no-image.png'" />

                <div class="card-body">
                    <h5 class="card-title">@p.Name</h5>

                    @if (p.Discount > 0)
                    {
                        <span class="badge bg-danger mb-2">-@p.Discount%</span>
                    }

                    <p class="mt-2">
                        @if (p.Discount > 0)
                        {
                            <span class="fw-bold text-danger">
                                @(p.Price - (p.Price * p.Discount / 100))
                            </span>
                            <del class="text-muted ms-2">@p.Price</del>
                        }
                        else
                        {
                            <span class="fw-bold">@p.Price</span>
                        }
                    </p>

                    <!-- ADD TO CART -->
                    <form asp-controller="Cart"
                          asp-action="AddToCart"
                          method="post"
                          class="d-flex gap-2">

                        @Html.AntiForgeryToken()

                        <input type="hidden" name="productId" value="@p.Id" />
                        <input type="hidden" name="quantity" value="1" />

                        <button type="submit"
                                class="btn btn-success btn-sm">
                            🛒 Thêm
                        </button>

                        <a asp-controller="Product"
                           asp-action="Detail"
                           asp-route-id="@p.Id"
                           class="btn btn-outline-secondary btn-sm">
                            Chi tiết
                        </a>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.PageCount > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.PageCount; i++)
            {
                <li class="page-item @(i == Model.CurrentPageIndex ? "active" : "")">
                    <a class="page-link" href="?page=@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
