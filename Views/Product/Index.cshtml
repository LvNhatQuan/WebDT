@model WebDT.Models.ProductPagination
@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<!-- Modal thông báo -->
<div class="modal fade" id="modalAddToCartSuccess" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thông báo</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-success fw-bold">
                Sản phẩm đã được thêm vào giỏ hàng!
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    @foreach (var item in Model.Products)
    {
        <div class="col-md-6 col-lg-4">
            <div class="rounded shadow-sm border p-3 h-100">

                <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.Id">
                    <img src="~/Images/SanPham/@item.Image_url"
                         class="img-fluid rounded"
                         style="aspect-ratio:1.3; object-fit:cover" />
                </a>

                <h5 class="mt-3">@item.Name</h5>

                <p class="text-muted" style="height: 48px; overflow: hidden;">
                    @item.Description
                </p>

                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-primary">@item.Price.ToString("#,##0 VND")</span>

                    <button class="btn btn-outline-primary rounded-pill px-3"
                            onclick="clickAddToCart(@item.Id)">
                        <i class="fa fa-shopping-bag"></i> Thêm
                    </button>
                </div>

            </div>
        </div>
    }
</div>

<!-- PHÂN TRANG -->
<div class="col-12 mt-4">
    <div class="pagination d-flex justify-content-center">
        @for (int i = 1; i <= Model.PageCount; i++)
        {
            <a asp-controller="Product"
               asp-action="Index"
               asp-route-page="@i"
               class="rounded px-3 py-1 @(i == Model.CurrentPageIndex ? "bg-primary text-white" : "border")">
                @i
            </a>
        }
    </div>
</div>

<script>
    function clickAddToCart(idProduct) {
        $.ajax({
            url: '@Url.Action("AddToCart", "Cart")',
            type: 'POST',
            data: { id: idProduct, quantity: 1 },
            success: function (res) {
                if (res.success) {

                    // Refresh Cart icon
                    $.get('@Url.Action("RefreshCartViewComponent", "Cart")', function (html) {
                        $("#cart_view_component").html(html);
                    });

                    $("#modalAddToCartSuccess").modal("show");
                }
                else {
                    if (res.redirectUrl) {
                        window.location.href = res.redirectUrl;
                    } else {
                        alert(res.message);
                    }
                }
            },
            error: function (err) {
                console.log(err);
                alert("Lỗi hệ thống.");
            }
        });
    }
</script>
