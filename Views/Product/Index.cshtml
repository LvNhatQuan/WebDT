@model WebDT.Models.ProductPagination
@{
    ViewData["Title"] = "Danh sách sản phẩm";

    // Lấy tham số từ ViewData
    var categoryId = ViewData["CategoryId"] as int?;
    var sortOrder = ViewData["SortOrder"] as string;
}
<!-- Thanh tìm kiếm -->
<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <form action="/Product/Search" method="get">
                <div class="d-flex align-items-center gap-3">
                    <div class="input-group flex-grow-1">
                        <span class="input-group-text bg-white border-dark border-end-0 rounded-start-pill ps-3">
                            <i class="fa-solid fa-magnifying-glass text-secondary"></i>
                        </span>
                        <input type="text"
                               class="form-control border-dark border-start-0 rounded-end-pill shadow-none ps-2"
                               placeholder="Tìm kiếm sản phẩm...."
                               name="keyword"
                               value="@ViewData["SearchKeyword"]"
                               aria-label="Search">
                    </div>
                    <button class="btn border-black btn-danger rounded-pill px-4 py-2 fw-bold" type="submit">
                        Tìm
                    </button>

                    <!-- Dropdown sắp xếp -->
                    <div class="dropdown ms-auto" style="margin-left:100px;">
                        <button class="btn btn-outline-dark rounded-circle d-flex align-items-center justify-content-center"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                style="width: 45px; height: 45px;">
                            <i class="fa-solid fa-filter fs-5"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 ms-auto">
                            <li><h6 class="dropdown-header text-center">Sắp xếp theo</h6></li>
                            <li>
                                <a class="dropdown-item py-2 @(sortOrder == "price_desc" ? "active" : "")"
                                   href="?categoryId=@(categoryId.HasValue? categoryId.Value.ToString() : "")&sortOrder=price_desc&page=1">
                                    <i class="fa-solid fa-arrow-down-wide-short me-2 @(sortOrder == "price_desc" ? "text-primary" : "text-muted")"></i>
                                    Giá cao → thấp
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 @(sortOrder == "price_asc" ? "active" : "")"
                                   href="?categoryId=@(categoryId.HasValue? categoryId.Value.ToString() : "")&sortOrder=price_asc&page=1">
                                    <i class="fa-solid fa-arrow-up-wide-short me-2 @(sortOrder == "price_asc" ? "text-primary" : "text-muted")"></i>
                                    Giá thấp → cao
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item py-2 @(sortOrder == "best_selling" ? "active" : "")"
                                   href="?categoryId=@(categoryId.HasValue? categoryId.Value.ToString() : "")&sortOrder=best_selling&page=1">
                                    <i class="fa-solid fa-fire me-2 @(sortOrder == "best_selling" ? "text-danger" : "text-danger")"></i>
                                    Bán chạy nhất
                                </a>
                            </li>
                        </ul>
                    </div>
                    <!-- End Dropdown -->
                </div>
            </form>
        </div>
    </div>
</div>
<!-- Thanh tìm kiếm -->
<!-- Hiển thị sản phẩm -->
<fieldset class="custom-fieldset mt-5">
    <legend>Yến Sào</legend>

    <!-- Hiển thị trạng thái sắp xếp hiện tại -->
    @if (!string.IsNullOrEmpty(sortOrder))
    {
        <div class="mb-3">
            <small class="text-muted">
                Đang sắp xếp theo:
                @switch (sortOrder)
                {
                    case "price_desc":
                        <span class="text-primary">Giá cao → thấp</span>
                        break;
                    case "price_asc":
                        <span class="text-primary">Giá thấp → cao</span>
                        break;
                    case "best_selling":
                        <span class="text-danger">Bán chạy nhất</span>
                        break;
                }
                <a href="?categoryId=@(categoryId.HasValue? categoryId.Value.ToString() : "")&page=1" class="text-decoration-none ms-2">
                    <i class="fa-solid fa-xmark"></i> Bỏ sắp xếp
                </a>
            </small>
        </div>
    }

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-3">
        @if (Model.Products.Any())
        {
            @foreach (var p in Model.Products)
            {
                <div class="col">
                    <div class="card h-100 border1 background1 shadow-sm product-card rounded-0">
                        <div class="p-2 overflow-hidden">
                            <a asp-controller="Product"
                               asp-action="Detail"
                               asp-route-id="@p.Id"
                               class="d-block text-decoration-none zoom-container">
                                <img src="~/Images/SanPham/@p.ImageUrl"
                                     class="w-100 zoom-img"
                                     style="height: 180px; object-fit: contain; mix-blend-mode: multiply;"
                                     alt="@p.Name"
                                     onerror="this.src='/Images/yen_sua.jpg'" />

                            </a>
                        </div>

                        <div class="card-body d-flex flex-column text-center pt-0">
                            <h5 class="card-title fw-bold text-uppercase mb-2 text-truncate" style="font-size: 0.9rem;">
                                @p.Name
                            </h5>
                            <div class="d-flex justify-content-center flex-lg-wrap">
                                @if (p.Discount > 0)
                                {
                                    <span class="fw-bold text-danger me-2">
                                        @((p.Price - (p.Price * p.Discount / 100)).ToString("#,##0 đ"))
                                    </span>
                                    <del class="text-muted me-2">
                                        @p.Price.ToString("#,##0")
                                    </del>
                                    <span class="badge bg-danger">
                                        -@p.Discount%
                                    </span>
                                }
                                else
                                {
                                    <p class="text-dark fs-6 fw-bold mb-0">
                                        @p.Price.ToString("#,##0 đ")
                                    </p>
                                }
                            </div>

                            <form asp-controller="Cart"
                                  asp-action="AddToCart"
                                  method="post"
                                  class="d-flex gap-2">

                                @Html.AntiForgeryToken()

                                <input type="hidden" name="productId" value="@p.Id" />
                                <input type="hidden" name="quantity" value="1" />
                                <div class="d-flex w-100 gap-1 mt-auto">
                                    <button type="submit"
                                            class="btn btn1 btn-outline-dark rounded-pill btn-sm flex-fill text-nowrap mt-2 px-1">
                                        <span style="font-size: 13px; font-weight: bold;">Thêm vào giỏ</span>
                                    </button>

                                    <a asp-controller="Product"
                                       asp-action="Detail"
                                       asp-route-id="@p.Id"
                                       class="btn btn1 btn-outline-dark rounded-pill btn-sm flex-fill text-nowrap mt-2 px-1">
                                        <span style="font-size: 13px; font-weight: bold;">Chi tiết</span>
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted">Không có sản phẩm nào.</p>
            </div>
        }
    </div>
</fieldset>

<!-- Phân trang -->
@if (Model.PageCount > 1)
{
    <nav aria-label="Page navigation" class="mt-5">
        <ul class="pagination justify-content-center">
            @if (Model.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link"
                       href="?keyword=@ViewData["SearchKeyword"]&sortOrder=@ViewData["SortOrder"]&page=@(Model.CurrentPageIndex - 1)">
                        <i class="fa-solid fa-chevron-left"></i>
                    </a>
                </li>
            }

            @for (int i = 1; i <= Model.PageCount; i++)
            {
                <li class="page-item @(i == Model.CurrentPageIndex ? "active" : "")">
                    <a class="page-link"
                       href="?keyword=@ViewData["SearchKeyword"]&sortOrder=@ViewData["SortOrder"]&page=@i">
                        @i
                    </a>
                </li>
            }

            @if (Model.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link"
                       href="?keyword=@ViewData["SearchKeyword"]&sortOrder=@ViewData["SortOrder"]&page=@(Model.CurrentPageIndex + 1)">
                        <i class="fa-solid fa-chevron-right"></i>
                    </a>
                </li>
            }
        </ul>
    </nav>
}
}
<style>
    .dropdown-item.active {
        background-color: #f8f9fa;
        color: #000;
        font-weight: bold;
    }

    .dropdown-item:hover {
        background-color: #e9ecef;
    }

    .product-card:hover {
        transform: translateY(-5px);
        transition: transform 0.3s ease;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
</style>


