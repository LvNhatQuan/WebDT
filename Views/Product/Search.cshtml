@model WebDT.Models.ProductPagination
@{
    ViewData["Title"] = "Kết quả tìm kiếm";
}

<!-- Thanh tìm kiếm -->
<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <form action="/Product/Search" method="get">
                <div class="d-flex align-items-center gap-3">
                    <div class="input-group flex-grow-1">
                        <span class="input-group-text bg-white border-dark border-end-0 rounded-start-pill ps-3">
                            <i class="fa-solid fa-magnifying-glass text-secondary"></i>
                        </span>
                        <input type="text"
                               class="form-control border-dark border-start-0 rounded-end-pill shadow-none ps-2"
                               placeholder="Tìm kiếm sản phẩm...."
                               name="keyword"
                               value="@ViewData["SearchKeyword"]"
                               aria-label="Search">
                    </div>
                    <button class="btn border-black btn-danger rounded-pill px-4 py-2 fw-bold" type="submit">
                        Tìm
                    </button>

                    <!-- Dropdown sắp xếp -->
                    <div class="dropdown ms-auto">
                        <button class="btn btn-outline-dark rounded-circle d-flex align-items-center justify-content-center"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                style="width: 45px; height: 45px;">
                            <i class="fa-solid fa-filter fs-5"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                            <li><h6 class="dropdown-header text-center">Sắp xếp theo</h6></li>
                            <li>
                                <a class="dropdown-item py-2"
                                   href="?keyword=@ViewData["SearchKeyword"]&sortOrder=price_desc">
                                    <i class="fa-solid fa-arrow-down-wide-short me-2 text-muted"></i>Giá cao → thấp
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2"
                                   href="?keyword=@ViewData["SearchKeyword"]&sortOrder=price_asc">
                                    <i class="fa-solid fa-arrow-up-wide-short me-2 text-muted"></i>Giá thấp → cao
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item py-2 fw-bold"
                                   href="?keyword=@ViewData["SearchKeyword"]&sortOrder=best_selling">
                                    <i class="fa-solid fa-fire me-2 text-danger"></i>Bán chạy nhất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Hiển thị sản phẩm -->
@if (Model.Products.Any())
{
    <div class="container mt-5">
        <h4 class="mb-4">Kết quả tìm kiếm cho: "<span class="text-danger">@ViewData["SearchKeyword"]</span>"</h4>

        <!-- Thông báo sắp xếp -->
        @{
            var sortText = "";
            switch (ViewData["SortOrder"]?.ToString())
            {
                case "price_desc":
                    sortText = "Giá cao → thấp";
                    break;
                case "price_asc":
                    sortText = "Giá thấp → cao";
                    break;
                case "best_selling":
                    sortText = "Bán chạy nhất";
                    break;
                default:
                    sortText = "Mới nhất";
                    break;
            }
        }

        <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
            <i class="fa-solid fa-sort me-2"></i>
            <span>Đang sắp xếp theo: <strong>@sortText</strong> | Tìm thấy <strong>@Model.TotalItems</strong> sản phẩm</span>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-3">
            @if (Model.Products.Any())
            {
                @foreach (var p in Model.Products)
                {
                    <div class="col">
                        <div class="card h-100 border1 background1 shadow-sm product-card rounded-0">
                            <div class="p-2 overflow-hidden">
                                <a asp-controller="Product"
                                   asp-action="Detail"
                                   asp-route-id="@p.Id"
                                   class="d-block text-decoration-none zoom-container">
                                    <img src="~/Images/SanPham/@p.ImageUrl"
                                         class="w-100 zoom-img"
                                         style="height: 180px; object-fit: contain; mix-blend-mode: multiply;"
                                         alt="@p.Name"
                                         onerror="this.src='/Images/yen_sua.jpg'" />

                                </a>
                            </div>

                            <div class="card-body d-flex flex-column text-center pt-0">
                                <h5 class="card-title fw-bold text-uppercase mb-2 text-truncate" style="font-size: 0.9rem;">
                                    @p.Name
                                </h5>
                                <div class="d-flex justify-content-center flex-lg-wrap">
                                    @if (p.Discount > 0)
                                    {
                                        <span class="fw-bold text-danger me-2">
                                            @((p.Price - (p.Price * p.Discount / 100)).ToString("#,##0 đ"))
                                        </span>
                                        <del class="text-muted me-2">
                                            @p.Price.ToString("#,##0")
                                        </del>
                                        <span class="badge bg-danger">
                                            -@p.Discount%
                                        </span>
                                    }
                                    else
                                    {
                                        <p class="text-dark fs-6 fw-bold mb-0">
                                            @p.Price.ToString("#,##0 đ")
                                        </p>
                                    }
                                </div>

                                <form asp-controller="Cart"
                                      asp-action="AddToCart"
                                      method="post"
                                      class="d-flex gap-2">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden" name="productId" value="@p.Id" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <div class="d-flex w-100 gap-1 mt-auto">
                                        <button type="submit"
                                                class="btn btn1 btn-outline-dark rounded-pill btn-sm flex-fill text-nowrap mt-2 px-1">
                                            <span style="font-size: 13px; font-weight: bold;">Thêm vào giỏ</span>
                                        </button>

                                        <a asp-controller="Product"
                                           asp-action="Detail"
                                           asp-route-id="@p.Id"
                                           class="btn btn1 btn-outline-dark rounded-pill btn-sm flex-fill text-nowrap mt-2 px-1">
                                            <span style="font-size: 13px; font-weight: bold;">Chi tiết</span>
                                        </a>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <p class="text-muted">Không có sản phẩm nào.</p>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.PageCount > 1)
        {
            <nav aria-label="Page navigation" class="mt-5">
                <ul class="pagination justify-content-center">
                    @if (Model.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               href="?keyword=@ViewData["SearchKeyword"]&sortOrder=@ViewData["SortOrder"]&page=@(Model.CurrentPageIndex - 1)">
                                <i class="fa-solid fa-chevron-left"></i>
                            </a>
                        </li>
                    }

                    @for (int i = 1; i <= Model.PageCount; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPageIndex ? "active" : "")">
                            <a class="page-link"
                               href="?keyword=@ViewData["SearchKeyword"]&sortOrder=@ViewData["SortOrder"]&page=@i">
                                @i
                            </a>
                        </li>
                    }

                    @if (Model.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               href="?keyword=@ViewData["SearchKeyword"]&sortOrder=@ViewData["SortOrder"]&page=@(Model.CurrentPageIndex + 1)">
                                <i class="fa-solid fa-chevron-right"></i>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
}
else if (!string.IsNullOrWhiteSpace(ViewData["SearchKeyword"]?.ToString()))
{
    <div class="container mt-5 text-center">
        <div class="alert alert-warning">
            <i class="fa-solid fa-triangle-exclamation fa-2x mb-3"></i>
            <h4>Không tìm thấy sản phẩm phù hợp với từ khóa: "@ViewData["SearchKeyword"]"</h4>
            <p class="mb-0">Vui lòng thử lại với từ khóa khác.</p>
        </div>
        <a href="/Product" class="btn btn-primary mt-3">
            <i class="fa-solid fa-arrow-left me-2"></i>Quay lại trang sản phẩm
        </a>
    </div>
}
else
{
    <div class="container mt-5 text-center">
        <div class="alert alert-info">
            <i class="fa-solid fa-info-circle fa-2x mb-3"></i>
            <h4>Nhập từ khóa để tìm kiếm sản phẩm</h4>
            <p class="mb-0">Sử dụng ô tìm kiếm ở trên để tìm kiếm sản phẩm bạn cần.</p>
        </div>
    </div>
}