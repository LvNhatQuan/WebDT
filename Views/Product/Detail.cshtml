@model WebDT.Models.Product
@{
    ViewData["Title"] = Model.Name;
}

<!-- ================== CHI TIẾT SẢN PHẨM ================== -->
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">
            <div class="card shadow-sm border-0 rounded-0 overflow-hidden">
                <div class="row g-0 align-items-center">

                    <!-- ẢNH SẢN PHẨM -->
                    <div class="col-12 col-md-5 bg-white">
                        <div class="p-3 d-flex align-items-center justify-content-center">
                            <img src="~/Images/SanPham/@Model.ImageUrl"
                                 class="img-fluid"
                                 style="max-height:380px; object-fit:contain; mix-blend-mode:multiply;"
                                 alt="@Model.Name"
                                 onerror="this.src='/Images/yen_sua.jpg'" />
                        </div>
                    </div>

                    <!-- THÔNG TIN -->
                    <div class="col-12 col-md-7">
                        <div class="card-body text-center">

                            <h2 class="fw-bold text-uppercase mb-3">
                                @Model.Name
                            </h2>

                            <!-- GIÁ -->
                            <div class="d-flex justify-content-center align-items-center mb-4">
                                @if (Model.Discount > 0)
                                {
                                    <span class="text-danger fw-bold fs-3 me-2">
                                        @((Model.Price - (Model.Price * Model.Discount / 100)).ToString("#,##0 đ"))
                                    </span>
                                    <del class="text-muted fs-5 me-2">
                                        @Model.Price.ToString("#,##0")
                                    </del>
                                    <span class="badge bg-danger fs-6">
                                        -@Model.Discount%
                                    </span>
                                }
                                else
                                {
                                    <span class="text-danger fw-bold fs-3">
                                        @Model.Price.ToString("#,##0 đ")
                                    </span>
                                }
                            </div>

                            <!-- SỐ LƯỢNG -->
                            <div class="d-flex justify-content-center align-items-center mb-4">
                                <span class="fw-bold me-3">Số lượng:</span>
                                <div class="input-group" style="width:120px;">
                                    <button class="btn btn-outline-dark" type="button" onclick="changeQty(-1)">
                                        <i class="fa-solid fa-minus"></i>
                                    </button>
                                    <input id="qty" type="number"
                                           class="form-control text-center fw-bold"
                                           value="1" min="1" />
                                    <button class="btn btn-outline-dark" type="button" onclick="changeQty(1)">
                                        <i class="fa-solid fa-plus"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- NÚT -->
                            <form asp-controller="Cart"
                                  asp-action="AddToCart"
                                  method="post"
                                  class="d-flex justify-content-center gap-3">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@Model.Id" />
                                <input type="hidden" name="quantity" id="cartQty" value="1" />

                                <button type="submit"
                                        class="btn btn-outline-dark rounded-pill px-4 fw-bold">
                                    Thêm vào giỏ
                                </button>

                                <button type="submit"
                                        class="btn btn-dark rounded-pill px-4 fw-bold">
                                    Mua ngay
                                </button>
                            </form>

                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================== MÔ TẢ ================== -->
<div class="container mb-4">
    <div class="border">
        <h5 class="fw-bold m-0 p-3" style="background:#F1A3A2;">
            THÔNG TIN SẢN PHẨM
        </h5>
        <div class="bg-white p-4" style="font-size:1.1rem; line-height:1.6;">
            @Html.Raw(Model.Description)
        </div>
    </div>
</div>

<!-- ================== SẢN PHẨM LIÊN QUAN ================== -->
@await Component.InvokeAsync("RelatedProducts", new { productId = Model.Id, limit = 5 })

<hr />

<!-- ================== ĐÁNH GIÁ ================== -->
<div class="container mb-5">
    <h4 class="fw-bold mb-3">ĐÁNH GIÁ SẢN PHẨM</h4>

    @if (ViewBag.ReviewCount > 0)
    {
        <p class="mb-3">
            ⭐ <strong>@ViewBag.AvgRating.ToString("0.0") / 5</strong>
            <span class="text-muted">(@ViewBag.ReviewCount đánh giá)</span>
        </p>

        @foreach (var r in (List<WebDT.Models.Review>)ViewBag.Reviews)
        {
            <div class="border rounded p-3 mb-3 bg-white">
                <div class="d-flex justify-content-between">
                    <strong>@r.UserName</strong>
                    <small class="text-muted">
                        @r.CreatedAt.ToString("dd/MM/yyyy")
                    </small>
                </div>

                <div class="text-warning my-2">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <i class="@(i <= r.Rating ? "fa-solid" : "fa-regular") fa-star"></i>
                    }
                </div>

                <p class="mb-0">@r.Comment</p>
            </div>
        }
    }
    else
    {
        <p class="text-muted">Chưa có đánh giá nào cho sản phẩm này.</p>
    }
</div>

<script>
    function changeQty(step) {
        let qty = document.getElementById("qty");
        let cartQty = document.getElementById("cartQty");
        let val = parseInt(qty.value) + step;
        if (val < 1) val = 1;
        qty.value = val;
        cartQty.value = val;
    }
</script>
