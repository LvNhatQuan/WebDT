@model WebDT.Models.Product
@{
    ViewData["Title"] = Model.Name;
}
<!-- Chi tiết sản phẩm -->
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">
            <div class="card border1 background1 shadow-sm rounded-0 overflow-hidden">
                <div class="row g-0 align-items-center">
                    <div class="col-7 col-md-5">
                        <div class="p-2 text-center bg-white h-100 d-flex align-items-center justify-content-center">
                            <img src="~/Images/SanPham/@Model.ImageUrl"
                                 class="img-fluid"
                                 style="max-height: 380px; object-fit: contain; mix-blend-mode: multiply;"
                                 alt="@Model.Name" />
                        </div>
                    </div>

                    <div class="col-5 col-md-7">
                        <div class="card-body d-flex flex-column align-items-center justify-content-center h-100">
                            <h2 class="card-title fw-bold text-uppercase mb-2 text-center" style="">
                                @Model.Name
                            </h2>
                            <div class="d-flex align-items-center mb-4">
                            @if (Model.Discount > 0)
                            {
                                <span class="card-text text-danger fw-bold fs-3 mb-3 text-center me-2">
                                    @((Model.Price - (Model.Price * Model.Discount / 100)).ToString("#,##0 đ"))
                                </span>
                                <del class="card-text text-black fw-bold fs-3 mb-3 text-center me-2">
                                    @Model.Price.ToString("#,##0")
                                </del>
                                <span class="card-text text-white fw-bold fs-3 mb-3 text-center badge bg-danger">
                                    -@Model.Discount%
                                </span>
                            }
                            else
                            {
                                <p class="card-text text-danger fw-bold fs-3 mb-3 text-center">
                                    @Model.Price.ToString("#,##0 đ")
                                </p>
                            }
                            </div>
                            <div class="d-flex align-items-center mb-4">
                                <span class="card-text fs-6 me-3 fw-bold text-nowrap">
                                    Số lượng:
                                </span>

                                <div class="input-group" style="width: 120px;">
                                    <button class="btn btn-outline-dark rounded-0 px-2" type="button" onclick="decreaseQuantity(this)">
                                        <i class="fa-solid fa-minus" style="font-size: 0.8rem;"></i>
                                    </button>

                                    <input type="number"
                                           class="form-control text-center border-dark rounded-0 shadow-none px-0"
                                           value="1"
                                           min="1"
                                           max="100"
                                           style="font-weight: bold;" />

                                    <button class="btn btn-outline-dark rounded-0 px-2" type="button" onclick="increaseQuantity(this)">
                                        <i class="fa-solid fa-plus" style="font-size: 0.8rem;"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <form asp-controller="Cart"
                                      asp-action="AddToCart"
                                      method="post"
                                      class="d-flex gap-2">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden" name="productId" value="@Model.Id" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <div class="d-flex w-100 gap-1 mt-auto">
                                        <button type="submit"
                                                class="btn btn2 btn-outline-dark rounded-pill px-4 py-2">
                                            <span style="font-size: 20px; font-weight: bold;">Thêm vào giỏ</span>
                                        </button>

                                        <a asp-controller="Product"
                                           asp-action="Detail"
                                           asp-route-id="@Model.Id"
                                           class="btn btn2 btn-outline-dark rounded-pill px-4 py-3">
                                            <span style="font-size: 20px; font-weight: bold;">Mua</span>
                                        </a>
                                    </div>
                                </form>                       
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
    <script>
        // Hàm giảm số lượng
        function decreaseQuantity(button) {
            // Tìm ô input nằm ngay cạnh cái nút vừa bấm
            var input = button.parentElement.querySelector('input[type=number]');
            var value = parseInt(input.value);

            // Chỉ giảm nếu giá trị > 1 (hoặc > min)
            if (value > 1) {
            input.value = value - 1;
            }
        }

        // Hàm tăng số lượng
        function increaseQuantity(button) {
            var input = button.parentElement.querySelector('input[type=number]');
            var value = parseInt(input.value);

        // Bạn có thể check max value ở đây nếu muốn (ví dụ tồn kho)
        input.value = value + 1;
        }
    </script>
</div>
<div class="border border-dark mb-4">
    
    <h1 class="m-0 text-black fw-bold" style="background:#F1A3A2; padding:10px; font-size: 1.5rem;">
        THÔNG TIN SẢN PHẨM
    </h1>

    <div class="bg-white p-3">
        <div style="font-size: 1.2rem; line-height: 1.6;">
            @Html.Raw(Model.Description) 
            </div>
    </div>

</div>
<!-- Chi tiết sản phẩm -->
@await Component.InvokeAsync("RelatedProducts", new { productId = Model.Id, limit = 5 })