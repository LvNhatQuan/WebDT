@model WebDT.Models.Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="row">
    <div class="col-md-5">

        <!-- IMAGE -->
        <img src="~/Images/SanPham/@Model.ImageUrl"
             alt="@Model.Name"
             class="img-fluid border rounded"
             style="max-height:400px; object-fit:contain"
             onerror="this.src='/Images/no-image.png'" />

    </div>

    <div class="col-md-7">
        <h2>@Model.Name</h2>

        <p class="text-muted">@Model.CategoryName</p>

        <hr />

        <p>@Model.Description</p>

        <h4 class="mt-3">
            @if (Model.Discount > 0)
            {
                <span class="text-danger fw-bold">
                    @(Model.Price - (Model.Price * Model.Discount / 100))
                </span>
                <del class="text-muted ms-2">@Model.Price</del>
            }
            else
            {
                <span>@Model.Price</span>
            }
        </h4>

        <hr />

        <!-- ADD TO CART -->
        <form asp-controller="Cart"
              asp-action="AddToCart"
              method="post"
              class="mt-3">

            @Html.AntiForgeryToken()

            <input type="hidden" name="productId" value="@Model.Id" />

            <div class="mb-3" style="width:150px">
                <label class="form-label">Số lượng</label>
                <input type="number"
                       name="quantity"
                       value="1"
                       min="1"
                       class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary">
                🛒 Thêm vào giỏ hàng
            </button>

            <a asp-controller="Product"
               asp-action="Index"
               class="btn btn-outline-secondary ms-2">
                ← Quay lại
            </a>
        </form>
    </div>
</div>
