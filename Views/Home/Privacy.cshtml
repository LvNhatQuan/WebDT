            if (hash) {
                // 2. Tìm cái nút menu bên trái có href trùng với hash đó
                // Class .list-group-item là class của các nút menu bên trái trong code cũ mình đưa
                var triggerEl = document.querySelector('.list-group-item[href="' + hash + '"]');

                if (triggerEl) {
                    // 3. Kích hoạt tab đó bằng Bootstrap API
                    var tab = new bootstrap.Tab(triggerEl);
                    tab.show();

                    // 4. (Tùy chọn) Cuộn màn hình lên đầu cho dễ nhìn
                    triggerEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }
        });
