@using System.Globalization
@{
    ViewData["Title"] = "Home Page";
    var culture = CultureInfo.GetCultureInfo("vi-VN");

    var featuredProducts = ViewBag.FeaturedProducts as List<WebDT.Models.Product>;
    var bestSellerProducts = ViewBag.BestSellerProducts as List<WebDT.Models.Product>;
    var categories = ViewBag.Categories;
}

<div class="parent">

    <!-- ================= HEADER / EMPTY ================= -->
    <div class="div1"></div>

    <!-- ================= BANNER SLIDER ================= -->
    <div class="div2 mb-5">
        <div id="homeBannerCarousel"
             class="carousel slide"
             data-bs-ride="carousel"
             data-bs-interval="4000">

            <div class="carousel-inner rounded shadow">

                <div class="carousel-item active">
                    <img src="@Url.Content("~/Images/banner1.jpg")"
                         class="d-block w-100"
                         style="max-height:550px"
                         alt="Banner 1">
                </div>

                <div class="carousel-item">
                    <img src="@Url.Content("~/Images/banner2.jpg")"
                         class="d-block w-100"
                         style="max-height:550px"
                         alt="Banner 2">
                </div>

                @*  <div class="carousel-item">
                    <img src="@Url.Content("~/Images/banner3.jpg")"
                         class="d-block w-100"
                         alt="Banner 3">
                </div> *@
            </div>

            <button class="carousel-control-prev"
                    type="button"
                    data-bs-target="#homeBannerCarousel"
                    data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>

            <button class="carousel-control-next"
                    type="button"
                    data-bs-target="#homeBannerCarousel"
                    data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>
    </div>

    <!-- ================= SẢN PHẨM NỔI BẬT ================= -->
    <div class="div3 my-5">
        <h2 class="text-center text-primary fw-bold mb-4">
            🌟 SẢN PHẨM NỔI BẬT
        </h2>

        <div class="row row-cols-2 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-3">
            @if (featuredProducts != null && featuredProducts.Any())
            {
                // 1. Khai báo biến đếm
                int i = 0;

                foreach (var item in featuredProducts)
                {
                    // 2. Tạo logic class: Nếu là phần tử thứ 5 (index 4) thì ẩn ở mobile/tablet, chỉ hiện ở Large (Laptop)
                    string hideClass = (i == 4) ? "d-none d-lg-block" : "";

                    // Thêm biến hideClass vào class của thẻ col
                    <div class="col @hideClass">
                        <div class="card h-100 border1 background1 shadow-sm product-card rounded-0">
                            <div class="p-2 overflow-hidden">
                                <a asp-controller="Product"
                                   asp-action="Detail"
                                   asp-route-id="@item.Id"
                                   class="d-block text-decoration-none zoom-container">
                                    <img src="@Url.Content("~/Images/SanPham/" + item.ImageUrl)"
                                         onerror="this.onerror=null;this.src='@Url.Content("~/Images/no-image.png")';"
                                         class="card-img-top"
                                         style="height:200px;object-fit:cover;"
                                         alt="@item.Name" />
                                </a>
                            </div>
                            <div class="card-body text-center d-flex flex-column">
                                <h6 class="card-title text-truncate" title="@item.Name">
                                    @item.Name
                                </h6>

                                <p class="text-danger fw-bold mb-2">
                                    @string.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:N0} ₫", item.Price)
                                </p>
                                <!-- NÚT -->
                                <div class="mt-auto d-flex justify-content-center gap-2">
                                <form asp-controller="Cart"
                                      asp-action="AddToCart"
                                      method="post"
                                      class="d-flex justify-content-center gap-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.Id" />
                                    <input type="hidden" name="quantity" id="cartQty" value="1" />

                                    <button type="submit"
                                                class="btn btn-success btn-sm">
                                            Thêm vào giỏ
                                    </button>

                                        <a asp-controller="Product"
                                           asp-action="Detail"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-primary btn-sm">
                                            Chi tiết
                                        </a>
                                </form>
                                </div>
                                
                            </div>
                        </div>
                    </div>

                    // 3. Tăng biến đếm
                    i++;
                }
            }
            else
            {
                <p class="text-center text-muted">
                    Chưa có sản phẩm nổi bật
                </p>
            }
        </div>
    </div>

    <!-- ================= SẢN PHẨM BÁN CHẠY ================= -->
    <div class="div3 my-5 bg-light py-4">
        <h2 class="text-center text-success fw-bold mb-4">
            🔥 SẢN PHẨM BÁN CHẠY
        </h2>

        <div class="row row-cols-2 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-3">
            @if (bestSellerProducts != null && bestSellerProducts.Any())
            {
                // 1. Khai báo biến đếm
                int i = 0;

                foreach (var item in bestSellerProducts)
                {
                    // 2. Logic ẩn hiện: Nếu là sản phẩm thứ 5 (index 4) thì ẩn ở mobile, hiện ở Laptop (lg)
                    string hideClass = (i == 4) ? "d-none d-lg-block" : "";

                    // Thêm biến @hideClass vào class của col
                    <div class="col @hideClass">
                        <div class="card h-100 border1 background1 shadow-sm product-card rounded-0">
                            <div class="p-2 overflow-hidden">
                                <a asp-controller="Product"
                                   asp-action="Detail"
                                   asp-route-id="@item.Id"
                                   class="d-block text-decoration-none zoom-container">
                                    <img src="@Url.Content("~/Images/SanPham/" + item.ImageUrl)"
                                         onerror="this.onerror=null;this.src='@Url.Content("~/Images/no-image.png")';"
                                         class="card-img-top"
                                         style="height:200px;object-fit:cover;"
                                         alt="@item.Name" />
                                </a>
                            </div>
                            <div class="card-body text-center d-flex flex-column">
                                <h6 class="card-title text-truncate">
                                    @item.Name
                                </h6>

                                <p class="text-danger fw-bold mb-2">
                                    @string.Format(culture, "{0:N0} ₫", item.Price)
                                </p>

                                <!-- NÚT -->
                                <div class="mt-auto d-flex justify-content-center gap-2">
                                    <form asp-controller="Cart"
                                          asp-action="AddToCart"
                                          method="post"
                                          class="d-flex justify-content-center gap-3">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.Id" />
                                        <input type="hidden" name="quantity" id="cartQty" value="1" />

                                        <button type="submit"
                                                class="btn btn-success btn-sm">
                                            Thêm vào giỏ
                                        </button>

                                        <a asp-controller="Product"
                                           asp-action="Detail"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-primary btn-sm">
                                            Chi tiết
                                        </a>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

                    // 3. Tăng biến đếm sau mỗi vòng lặp
                    i++;
                }
            }
        </div>
    </div>

    <div class="div4 text-center my-5">
        <h2 class="text-danger fw-bold mb-4">
            🏆 Chứng nhận chất lượng
        </h2>

        <div class="row g-2 justify-content-center px-2">

            <div class="col-4">
                <a href="@Url.Content("~/Images/chungnhan1.jpg")" class="zoom-container d-block">
                    <img src="@Url.Content("~/Images/chungnhan1.jpg")"
                         class="rounded shadow zoom-img w-100"
                         style="height: auto; aspect-ratio: 3/4; object-fit: contain; mix-blend-mode: multiply;" />
                </a>
            </div>

            <div class="col-4">
                <a href="@Url.Content("~/Images/chungnhan2.jpg")" class="zoom-container d-block">
                    <img src="@Url.Content("~/Images/chungnhan2.jpg")"
                         class="rounded shadow zoom-img w-100"
                         style="height: auto; aspect-ratio: 3/4; object-fit: contain; mix-blend-mode: multiply;" />
                </a>
            </div>

            <div class="col-4">
                <a href="@Url.Content("~/Images/chungnhan3.jpg")" class="zoom-container d-block">
                    <img src="@Url.Content("~/Images/chungnhan3.jpg")"
                         class="rounded shadow zoom-img w-100"
                         style="height: auto; aspect-ratio: 3/4; object-fit: contain; mix-blend-mode: multiply;" />
                </a>
            </div>

        </div>
    </div>

    <!-- ================= FOOTER / EMPTY ================= -->
    <div class="div5"></div>

</div>

<style>
    .product-card:hover {
        transform: translateY(-5px);
        transition: 0.2s;
    }
</style>
